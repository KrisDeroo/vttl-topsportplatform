# VTTL Topsportplatform — environment contract
# This file is committed; copy to .env.local and fill values for local dev.
# src/lib/env.ts validates every key at build time — missing required keys fail the build.

# ---- Database (Plan 01-02 provisions schema; Plan 01-16 pushes migrations) ----
# Pooler (port 6543) — used by application code at runtime
DATABASE_URL=postgres://postgres:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Non-pooler (port 5432) — used by Drizzle Kit for migrations (DDL needs direct connection)
DIRECT_DATABASE_URL=postgres://postgres:password@db.<project>.supabase.co:5432/postgres

# ---- Better Auth (Plan 01-05) ----
BETTER_AUTH_SECRET=<32-char-random-secret-generate-via-openssl-rand-base64-32>
BETTER_AUTH_URL=http://localhost:3000

# ---- Upstash Redis — REST endpoint for ratelimit + revocation (D-12) ----
UPSTASH_REDIS_REST_URL=https://eu1-<name>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<token-from-upstash-console>
# Upstash Redis — TCP/TLS endpoint for BullMQ workers (D-15)
# BullMQ uses Lua scripts + blocking commands; cannot use REST API
REDIS_URL=rediss://default:<password>@eu1-<name>.upstash.io:6379

# ---- Email — Resend EU-region (Plan 01-06) ----
# Verify the sender domain (vttl.be) in the Resend dashboard with SPF / DKIM / DMARC
RESEND_API_KEY=re_<key-from-resend-console>
EMAIL_FROM=noreply@vttl.be

# ---- Observability — Sentry + Logflare (Plan 01-13) ----
SENTRY_DSN=
LOGFLARE_API_KEY=
LOGFLARE_SOURCE=
LOG_LEVEL=info

# ---- GDPR — pgcrypto symmetric key for medical-event diagnosis fields (Plan 01-03) ----
# Must be at least 32 chars; rotate via medical_encryption_key migration if compromised
MEDICAL_ENCRYPTION_KEY=<32-char-symmetric-key>

# ---- Public (visible in client bundle) ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Default locale for new accounts and anonymous visitors (overridden per user via users.preferred_locale)
NEXT_PUBLIC_DEFAULT_LOCALE=nl

# ── Supabase Storage (Phase 2, FILE-01) ─────────────────────────────
# Service-role key bypasses Storage RLS — NEVER expose to client bundle.
# Source: Supabase Dashboard -> Project Settings -> API -> service_role secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR...

# ── ClamAV (Phase 2, VALID-04) ──────────────────────────────────────
# Coolify sidecar service exposes clamd on TCP 3310 (D-22).
# In dev without a sidecar, set CLAMAV_HOST=localhost and run
# `docker run --rm -p 3310:3310 clamav/clamav:stable` for ad-hoc testing.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
